# Copy to .env and adjust. .env is git-ignored.
#
# If you change DB_USER, DB_PASSWORD or DB_NAME, change DATABASE_URL to match.
# Postgres only reads these on the FIRST start of an empty data volume. Changing them
# afterwards has no effect on the existing database; to apply them, reset the volume
# with `docker compose down -v` (this deletes the data).

# Read by docker-compose.yml (the defaults there match these values)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=air_quality

# Read by the app. The ports must match the fixed host ports in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/air_quality
REDIS_URL=redis://localhost:6380/0

# Required in the X-Api-Key header of POST /snapshots
SNAPSHOT_API_KEY=change-me
